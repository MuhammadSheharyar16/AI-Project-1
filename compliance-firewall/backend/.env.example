# Copy to .env and fill in. Never commit the real .env (it is git-ignored).

# --- AI provider (GROQ_API_KEY, GROQ_MODEL and DATABASE_URL are required: the app will not start without them) ---
# Groq free API key (https://console.groq.com/keys).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Seconds allowed for each AI call before failing closed.
CHECK_TIMEOUT_S=8

# --- Storage ---
# Any SQLAlchemy URL. Later: postgresql+psycopg://user:pass@host/db (Neon / Supabase)
DATABASE_URL=sqlite:///./data/firewall.db

# --- Web / app ---
# Browser origins for Expo *web* (native apps ignore CORS). "*" is only honoured when DEBUG=true.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# DEBUG enables ?simulate=crash|timeout (demo cases 11-12) and, when tokens are empty, opens the
# token-protected endpoints. Keep false outside a local demo.
DEBUG=false
LOG_LEVEL=INFO

# --- AI governance ---
# Kill switch: false = the LLM is never called; answers that need AI fail closed (Error).
AI_ENABLED=true
# Hard cap on AI calls per minute across the app (stay under the Groq free tier).
AI_MAX_CALLS_PER_MINUTE=25

# --- AI security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# X-Admin-Token: PUT /rules, POST /rules/restore/{v}, POST /audit/{id}/review, POST /suite/run
ADMIN_TOKEN=
# X-API-Key: /check, /chat, /audit*, /rules (read), /governance. The admin token is accepted too.
API_TOKEN=
# Per-client (IP) requests per minute on endpoints that can trigger AI calls.
RATE_LIMIT_PER_MINUTE=60
# Redact emails, phones, card and CNIC numbers before storing them in the audit log.
AUDIT_REDACT_PII=true
